# SEAD release manifest - written by './deploy.sh release cut'. See releases/README.md.
#
# Pins every SEAD service built from a repository of its own to a tag, and the commit
# that tag pointed at when the release was cut. Everything kept in this repository is
# pinned by the commit this file is in, which carries the tag 2026-10.1.

SEAD_RELEASE=2026-10.1

# client - https://github.com/humlab-sead/sead_browser_client
SBC_RELEASE=2026-10.0
SBC_COMMIT=c9c5b6d952916132a82b67bc04eb5d9162a3f61f

# json_api_server - https://github.com/humlab-sead/json_api_server
JAS_RELEASE=v1.59.0
JAS_COMMIT=cf7c5ce9830ae152a90c3aedfad854a1c1a2aafd

# sead_query_api - https://github.com/humlab-sead/sead_query_api
SEAD_QUERY_API_RELEASE=v1.5.0-multi-polygon.2
SEAD_QUERY_API_COMMIT=bc7bf090fd98e9aa993e91bd4b46846c9af4f456

# The sqitch tag the database schema is deployed to (sead_change_control).
# A release never changes the database by itself; see './deploy.sh import-db'.
SEAD_CHANGE_CONTROL_RELEASE=@2026.10
