# The Athena ceramics prototype, as an experiment for './deploy.sh experiment apply athena'.
# Read by deploy.sh, never sourced: one KEY=value per line, no quotes, paths relative to
# the sead-deployment directory and without spaces. See
# plans/athena-ceramics-prototype-plan.md, "Phase 6".

EXPERIMENT_DESCRIPTION=Athena ceramics prototype: thin-section micrographs, their metadata and Whitbread frequency labels

# The refs of the services built from repositories of their own, checked out and built in
# place of the release's pins. Written to .env as SBC_RELEASE and JAS_RELEASE, so the
# branches have to be pushed to GitHub. 'experiment revert' returns them to the release.
SBC_RELEASE=experiment/athena
JAS_RELEASE=experiment/athena

# Where the experiment's data lives. It is not in git (the repository is public): it is
# made by make_web_images.py and the sqitch generator on a machine that has Athina's
# material, and copied to the servers by './deploy.sh remote experiment <target> athena'.
EXPERIMENT_DATA_DIR=local-work/athena

# The generated sqitch project, deployed to the stack's database from inside the
# postgresql container, which carries sqitch.
EXPERIMENT_SQITCH_DIR=local-work/athena/sqitch

# What 'remote experiment' copies to the same paths under the target's checkout: the
# micrographs (mounted into json_api_server by compose.yml in this directory) and the
# sqitch project. The CSVs and the originals stay where they are.
EXPERIMENT_SYNC_PATHS=local-work/athena/web local-work/athena/sqitch

# Must exist, and the first be non-empty, before 'experiment apply' does anything.
EXPERIMENT_REQUIRED_PATHS=local-work/athena/web/full/athena local-work/athena/sqitch/sqitch.plan

# The experiment's own sites, so that 'experiment apply' builds just these into the JAS
# site cache instead of rebuilding every site. A query run in the stack's database,
# printing one site_id per line.
EXPERIMENT_SITES_SQL=select site_id from tbl_sites where site_description like '%Athena ceramics prototype%' order by site_id
