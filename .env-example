COMPOSE_PROJECT_NAME=sead
CONTAINER_TOOL=
DOMAIN=localhost
SCHEME=https
CLIENT_RELEASE=latest
JAS_RELEASE=main
SBC_RELEASE=master
SEAD_QUERY_API_RELEASE=main
SEAD_CHANGE_CONTROL_RELEASE=@2026.04
SBC_BUILD=prod

# Ports
WEB_PORT=80
MONGO_EXPRESS_PORT=8082
JAS_PORT=8484
POSTGRESQL_PORT=5432

#Normally "sead_production" or "sead_staging", but can be mapped to any database name available in the postgresql instance
DATABASE_NAME=sead_staging

#The password of the postgres user (root) in the postgresql instance
DATABASE_POSTGRES_PASSWORD=

# A PostgreSQL user, should preferably be read-only
DATABASE_USER=sead_master
DATABASE_PASSWORD=

DATABASE_READ_ONLY_USER=sead_ro
DATABASE_READ_ONLY_PASSWORD=

#PostgREST
PGRST_USER=postgrest
POSTGREST_DB_PASSWORD=
PGRST_HOST=postgresql
PGRST_DB_SCHEMA=postgrest_api
PGRST_DB_ANON_ROLE=postgrest_anon
PGRST_LOG_LEVEL=info
PGRST_SERVER_HOST=*
PGRST_SERVER_PORT=3001

#MongoDB
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASSWORD=
MONGO_EXPRESS_USER=sead
MONGO_EXPRESS_PASSWORD=

#Sead Query API
QueryBuilderSetting__Store__Username=
QueryBuilderSetting__Store__Password=

# Redis
REDIS_VERSION=5-alpine
REDIS_HOST_PORT=6379:6379
REDIS_DATA_DIR=./database/redis
REDIS_CONF_FILE=./conf/redis/redis.conf
REDIS_PASSWORD=

# JSON API SERVER
JAS_API_PORT=8484
JAS_POSTGRES_HOST=postgresql
JAS_POSTGRES_PORT=5432
JAS_POSTGRES_DATABASE=sead_staging
JAS_POSTGRES_MAX_CONNECTIONS=10
JAS_MONGO_HOST=mongo
JAS_MONGO_DB=sead
JAS_CACHE_STORAGE_METHOD=mongo
JAS_MAX_CONCURRENT_FETCHES=5
JAS_USE_SITE_CACHE=true
JAS_USE_TAXA_CACHE=true
JAS_USE_ECOCODE_CACHE=true
JAS_USE_SINGLE_PERSISTENT_DBCON=false
JAS_USE_QUERY_CACHE=true
JAS_PROTECTED_ENDPOINTS_USER=sead
JAS_PROTECTED_ENDPOINTS_PASS=
JAS_SESSION_SECRET=
JAS_ARTIFICIAL_LATENCY_MS=0

#This is used for google sign-in when using viewstates

JAS_GOOGLE_CLIENT_ID=
JAS_GOOGLE_CLIENT_SECRET=

JAS_GITHUB_CLIENT_ID=
JAS_GITHUB_CLIENT_SECRET=

JAS_ORCID_CLIENT_ID=
JAS_ORCID_CLIENT_SECRET=
#Which ORCID the client above belongs to: https://sandbox.orcid.org (dev, with a sandbox
#client) or https://orcid.org (super and browser, each with its own production client).
#generate-env fills it in by DEPLOY_MODE.
JAS_ORCID_ISSUER=
JAS_AUTH_SALT=
#The sign-in options offered, in order. Google and GitHub stay off until each has an
#OAuth app registered for this domain's callback URL.
JAS_AUTH_PROVIDERS=saml,orcid
#The label of the SAML option in the sign-in dialog
JAS_SAML_LOGIN_LABEL=SEAD login

#### SEAD login (SAML) ####
#The router is the SAML Service Provider (https://$DOMAIN/shibboleth). See plans/sead-login-plan.md.
#local: the dev IdP (sead_idp, compose.override.yml). swamid: SWAMID, through SeamlessAccess.
#generate-env fills it in by DEPLOY_MODE.
SAML_FEDERATION=
#The dev IdP's hostname (dev only; needs an /etc/hosts entry and a host nginx block, see sead_idp/README.md)
SAML_DEV_IDP_HOST=
#Shared by the router and json_api_server; the router adds it to the SAML hand-off. Generated.
SEAD_SP_HANDOFF_SECRET=
#The dev IdP's admin password (for its test page) and secret salt. Dev only. Generated.
SAML_DEV_IDP_ADMIN_PASSWORD=
SAML_DEV_IDP_SECRET_SALT=

MARIA_DB_NAME=sead
MARIA_DB_ROOT_PASSWORD=
MARIA_DB_USER=sead
MARIA_DB_PASSWORD=

# MCP access mode: restricted | unrestricted
MCP_ACCESS_MODE=restricted

# postgres_mcp (custom HTTP MCP server) port and bearer token
MCP_PORT=4000
MCP_BEARER_TOKEN=

# Matomo settings - These are not actually ready by matomo (they are set during install via the web interface), but it's recommended to fill them out here for your own reference
MATOMO_SUPERUSER=
MATOMO_SUPERUSER_PASSWORD=

# Basic Auth for OpenRefine
HTACCESS_USER=sead
HTACCESS_PASSWORD=

# LLM settings (used by sead_authority_service)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434


#### SEAD agent ####
#The chatbox agent. By default it runs the pi harness against a locally hosted
#OpenAI-compatible model server, so no chat content and no credentials leave the
#deployment. Set SEAD_AGENT_LLM_PROVIDER=openai to try the OpenAI API instead.
SEAD_AGENT_PORT=8585
SEAD_AGENT_LLM_PROVIDER=local
#For the local provider, leave SEAD_AGENT_LLM_BASE_URL empty to disable the agent - it
#then answers 503. For OpenAI, leave it empty to use https://api.openai.com/v1.
#"localhost" inside the container is the container itself, so a model server on the
#podman host is reached at llm-host - the host-only address 10.123.0.1 installed by
#sead_agent/scripts/install-llm-host-iface.sh. Bind the model's ssh tunnel to that
#address rather than 0.0.0.0, so the model is not published on the LAN or the VPN.
SEAD_AGENT_LLM_BASE_URL=http://llm-host:5040/v1
#A locally hosted server usually ignores this, but one is always sent. For OpenAI,
#set this to an API key and leave SEAD_AGENT_LLM_BASE_URL empty to use
#https://api.openai.com/v1.
SEAD_AGENT_LLM_API_KEY=local
#Leave empty to use whatever the local server reports as served. OpenAI defaults to
#gpt-6-luna when this is empty.
SEAD_AGENT_LLM_MODEL=
#off, minimal, low, medium, high, xhigh or max. OpenAI Chat Completions tool calling is
#pinned to reasoning_effort=none in the agent config, because the SEAD chatbox depends on
#function tools.
SEAD_AGENT_THINKING_LEVEL=low
#System prompt. Leave empty for sead_agent/training/02_instructions.md, or point at a
#fuller context document mounted into the container. The agent's operating limits - what
#it will and won't answer - are not in this file; they are in
#sead_agent/training/01_operating-limits.md and are prepended to whatever you point this
#at, so an override cannot drop them by accident
SEAD_AGENT_INSTRUCTIONS_FILE=
#Expose pi's builtin file/shell tools to the model. They only reach a throwaway in-memory
#sandbox that contains nothing of the container, but a chat agent has no use for them
SEAD_AGENT_ENABLE_SANDBOX_TOOLS=false
SEAD_AGENT_TIMEOUT_MS=120000
SEAD_AGENT_MAX_INPUT_LENGTH=4000
#The reply goes in a chatbox. Capping it is what stops one "write me an essay" request
#occupying the GPU for minutes; raise it only if real answers are being cut short
SEAD_AGENT_MAX_OUTPUT_TOKENS=4096
#Two windows per visitor: a short one for bursts, a long one for someone pacing themselves
#just under it all day because our model is cheaper to use than their own
SEAD_AGENT_RATE_LIMIT_WINDOW_MS=60000
SEAD_AGENT_RATE_LIMIT_MAX_REQUESTS=10
SEAD_AGENT_RATE_LIMIT_LONG_WINDOW_MS=3600000
SEAD_AGENT_RATE_LIMIT_LONG_MAX_REQUESTS=60
#How many proxies of ours stand in front of the agent. Every per-visitor limit is counted
#against the address this picks out of X-Forwarded-For, and the client controls the left
#of that header, so this must match reality: 1 for the router alone, 2 if a load balancer
#or CDN that also appends sits in front of it, 0 if the agent is reached directly.
#Too high and everyone shares one bucket; too low and anyone can mint their own.
SEAD_AGENT_TRUSTED_PROXY_COUNT=1
#Origins allowed to post to the agent, comma separated. Empty means any, which is right
#for a public instance; set it to keep the chatbox from being wired into someone else's
#site. Only affects browsers - a script sends no Origin and is held by the rate limits.
SEAD_AGENT_ALLOWED_ORIGINS=
#How many messages may occupy the model at once, and how long a conversation is remembered
SEAD_AGENT_MAX_CONCURRENT_TURNS=2
SEAD_AGENT_MAX_SESSIONS=20
SEAD_AGENT_SESSION_TTL_MS=900000
#How long the service waits for the browser to run one command the agent asked for, and
#how many such commands one message may use before the agent has to answer with what it has
SEAD_AGENT_CLIENT_ACTION_TIMEOUT_MS=60000
SEAD_AGENT_MAX_CLIENT_ACTIONS=20
