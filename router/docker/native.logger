# The FastCGI authorizer and responder log to the console, like shibd
log4j.rootCategory=WARN, console

log4j.appender.console=org.apache.log4j.ConsoleAppender
log4j.appender.console.layout=org.apache.log4j.PatternLayout
log4j.appender.console.layout.ConversionPattern=shib-fcgi %d{%Y-%m-%d %H:%M:%S} %p %c %x: %m%n
